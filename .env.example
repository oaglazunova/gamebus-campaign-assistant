# Copy this file to .env and edit values locally.
# .env is ignored by git and should not be committed.

CAMPAIGN_ASSISTANT_LLM_ENABLED=true
CAMPAIGN_ASSISTANT_LLM_PROVIDER=ollama

# Recommended lighweight local model for testing
# Switch to a more powerful model for better results, e.g., qwen3:8b or llama3:8b, if you have the resources.
CAMPAIGN_ASSISTANT_LLM_MODEL=gemma3:1b

# Local Ollama endpoint:
CAMPAIGN_ASSISTANT_OLLAMA_HOST=http://localhost:11434

# Increase if larger local models answer slowly:
CAMPAIGN_ASSISTANT_LLM_TIMEOUT=180